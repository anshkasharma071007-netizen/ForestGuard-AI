{
  "expo": {
    "name": "Forest Guard AI",
    "slug": "forest-guard-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forestguardai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0C2418"
      },
      "package": "com.forestguardai.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#F4F1E8",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#171F1B"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Forest Guard AI to use your current location when you choose it."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Forest Guard AI to attach a photo to a wildlife report.",
          "cameraPermission": "Allow Forest Guard AI to take a photo for a wildlife report."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5273f5d8-8ffb-478a-ad40-40319c9b78ed"
      }
    },
    "owner": "kush07"
  }
}
