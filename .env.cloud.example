# Copy to .env.cloud and keep it private. Select this profile with FOREST_GUARD_DB_MODE=cloud.
APP_ENV=production
# Generate with: .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
CLOUD_DATABASE_HOST=
CLOUD_DATABASE_USER=forest_guard_app.<project-ref>
CLOUD_DATABASE_PASSWORD=
# Download the CA certificate in the Supabase dashboard (Database > Settings).
CLOUD_DATABASE_SSL_ROOT_CERT=.forest-guard-local/supabase-ca.crt

DEMO_MODE=false
SEED_ON_START=false
AUTHORITY_DEMO_ACCOUNTS_ENABLED=false
CITIZEN_DEV_OTP_ENABLED=false
AI_MODE=auto
# Use local for filesystem development or supabase for the private shared evidence bucket.
MEDIA_STORAGE=local
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_BUCKET=forest-guard-evidence
SUPABASE_STORAGE_KEY=
# UPLOAD_DIR=/path/to/private/forest-guard/uploads
# CORS_ORIGINS=https://authority.example.org,https://citizen.example.org
