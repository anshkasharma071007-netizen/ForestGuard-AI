# Forest Guard AI — environment configuration
# Run python -m tools.init_database to create .env, or copy and configure this example.
# Keep .env and passfiles private.

DEMO_MODE=true
SECRET_KEY=change-me-to-a-long-random-string
# Local PostgreSQL runtime account. Use the passfile created by the initializer.
DATABASE_URL=postgresql+psycopg://forest_guard_app@127.0.0.1:5432/forest_guard_ai
# PGPASSFILE=".forest-guard-local/forest_guard_ai-forest_guard_app.pgpass"
# Use forward slashes in Windows paths, e.g. C:/Users/you/private/forest-guard.pgpass
# For an independent SQLite database use DATABASE_URL=sqlite:///backend/database/dev.db
# For demo data, run python -m tools.seed_demo explicitly.
SEED_ON_START=false

# AI engine: auto | demo
# auto = YOLO-World localisation + CLIP species classification (requires torch + clip)
# demo = no model loading; uploads return a clear 503 instead of fabricated results
AI_MODE=demo
YOLO_WORLD_WEIGHTS=yolov8s-worldv2.pt
CLIP_MODEL=ViT-B/32
AI_CONFIDENCE_THRESHOLD=0.55

# Uploads
MAX_UPLOAD_MB=25

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Demo credentials (change for any real deployment)
DEMO_ADMIN_EMAIL=admin@forestguard.ai
DEMO_ADMIN_PASSWORD=forest123
DEMO_GUARD_EMAIL=guard@forestguard.ai
DEMO_GUARD_PASSWORD=guard123
