# Forest Guard AI — environment configuration
# Copy to .env and adjust. Never commit .env.

DEMO_MODE=true
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///backend/database/forest_guard.db

# AI engine: auto | demo
# auto = YOLO-World localisation + CLIP species classification (requires torch + clip)
# demo = no model loading; uploads return a clear 503 instead of fabricated results
AI_MODE=auto
YOLO_WORLD_WEIGHTS=yolov8s-worldv2.pt
CLIP_MODEL=ViT-B/32
AI_CONFIDENCE_THRESHOLD=0.55

# Uploads
MAX_UPLOAD_MB=25

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Demo credentials (change for any real deployment)
DEMO_ADMIN_EMAIL=admin@forestguard.ai
DEMO_ADMIN_PASSWORD=forest123
DEMO_GUARD_EMAIL=guard@forestguard.ai
DEMO_GUARD_PASSWORD=guard123
